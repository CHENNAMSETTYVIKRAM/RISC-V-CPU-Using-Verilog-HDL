// Program 4: In-place Bubble Sort of 8 words in data memory
// Inputs: mem[0..7] = [64, 34, 25, 12, 22, 11, 90, 4]
// Expected Output: mem[0..7] = [4, 11, 12, 22, 25, 34, 64, 90]
// Addr: Machine Code - Assembly Mnemonic
// 0x00: 00800093 - addi x1, x0, 8     # Outer loop limit N = 8
00800093
// 0x04: fff08093 - addi x1, x1, -1    # outer_loop: x1--
fff08093
// 0x08: 02008663 - beq  x1, x0, 44    # if x1 == 0 goto done
02008663
// 0x0C: 00000113 - addi x2, x0, 0     # x2 = 0 (inner index)
00000113
// 0x10: 00012183 - lw   x3, 0(x2)     # inner_loop: x3 = mem[x2]
00012183
// 0x14: 00412203 - lw   x4, 4(x2)     # x4 = mem[x2+4]
00412203
// 0x18: 0041c663 - blt  x3, x4, 12    # if x3 < x4 goto no_swap
0041c663
// 0x1C: 00412023 - sw   x4, 0(x2)     # mem[x2] = x4
00412023
// 0x20: 00312223 - sw   x3, 4(x2)     # mem[x2+4] = x3
00312223
// 0x24: 00410113 - addi x2, x2, 4     # no_swap: x2 += 4
00410113
// 0x28: 00209293 - slli x5, x1, 2     # x5 = x1 * 4
00209293
// 0x2C: fe5142e3 - blt  x2, x5, -28   # if x2 < x5 goto inner_loop
fe5142e3
// 0x30: fd5ff06f - jal  x0, -44       # goto outer_loop
fd5ff06f
// 0x34: 0000006f - jal  x0, 0         # done: halt
0000006f
